HOST=0.0.0.0
PORT=3001
PANEL_ORIGIN=*

# Holyrics Integration
HOLYRICS_PULL_ENABLED=true
HOLYRICS_HOST=192.168.0.7 # ip address of the Holyrics server
HOLYRICS_PORT=4747 # port of the Holyrics server
HOLYRICS_PATH=/view/text.json
HOLYRICS_METHOD=GET
HOLYRICS_TOKEN=
HOLYRICS_TOKEN_HEADER=Authorization
HOLYRICS_TEXT_PATH=map.text
HOLYRICS_PULL_INTERVAL_MS=400
HOLYRICS_TIMEOUT_MS=1500
